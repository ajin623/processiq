<?xml version="1.0" encoding="UTF-8"?>
<log xes.version="1.0" xes.features="">
    <extension
        name="Concept"
        prefix="concept"
        uri="http://www.xes-standard.org/concept.xesext"
    />
    <extension
        name="Time"
        prefix="time"
        uri="http://www.xes-standard.org/time.xesext"
    />
    <extension
        name="Organizational"
        prefix="org"
        uri="http://www.xes-standard.org/org.xesext"
    />

    <global scope="trace">
        <string key="concept:name" value="UNKNOWN" />
        <string key="Item Category" value="UNKNOWN" />
    </global>

    <global scope="event">
        <string key="concept:name" value="UNKNOWN" />
        <date
            key="time:timestamp"
            value="1970-01-01T00:00:00.000Z"
        />
        <string key="org:resource" value="UNKNOWN" />
    </global>

    <classifier
        name="Event Name"
        scope="event"
        keys="concept:name"
    />

    <trace>
        <string key="concept:name" value="case-1" />
        <string key="Item Category" value="2-way match" />
        <string key="Spend classification text" value="NPR" />

        <event>
            <string
                key="concept:name"
                value="Create Purchase Order"
            />
            <string key="org:resource" value="user_01" />
            <date
                key="time:timestamp"
                value="2018-01-01T10:00:00.000Z"
            />
        </event>

        <event>
            <string key="concept:name" value="Clear Invoice" />
            <string key="org:resource" value="NONE" />
            <date
                key="time:timestamp"
                value="2018-01-01T11:00:00.000Z"
            />
        </event>
    </trace>

    <trace>
        <string key="concept:name" value="case-2" />
        <string
            key="Item Category"
            value="3-way match, invoice before GR"
        />

        <event>
            <string
                key="concept:name"
                value="Create Purchase Order"
            />
            <string key="org:resource" value="batch_00" />
            <date
                key="time:timestamp"
                value="2018-01-02T09:30:00.000Z"
            />
        </event>
    </trace>
</log>